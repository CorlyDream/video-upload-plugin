{
  "name": "video-upload-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:feedback && npm run test:kuaishou && npm run test:douyin && npm run test:downloads && npm run test:weixin && npm run test:bilibili",
    "test:feedback": "node tests/browser.mjs --start-feedback",
    "test:kuaishou": "node tests/kuaishou-browser.mjs",
    "test:douyin": "node tests/douyin-browser.mjs",
    "test:xiaohongshu": "node tests/xiaohongshu-browser.mjs",
    "test:weixin": "node tests/weixin-browser.mjs",
    "test:bilibili": "node tests/bilibili-browser.mjs",
    "test:downloads": "node tests/downloads-browser.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
